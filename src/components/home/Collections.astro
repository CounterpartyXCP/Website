---
import { client } from "../../../tina/__generated__/client";
import { TinaMarkdown } from "tinacms/dist/rich-text";

const collectionsResponse = await client.queries.featuredCollections({ relativePath: "featured-collections.md" });
const collectionsContent = collectionsResponse.data.featuredCollections;
---

<section id="collections" class="bg-white py-16 relative">
  <div class="absolute inset-0 bg-repeat opacity-10 z-0" style="background-image: url('/images/pattern.png');"></div>
  <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl font-light text-blue-900 text-center mb-8">{collectionsContent.title}</h2>
    <div class="max-w-3xl mx-auto mb-12">
      <div class="text-center text-blue-900">
        <TinaMarkdown content={collectionsContent.introduction} />
      </div>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {collectionsContent.featuredCollectionList?.map((item) => (
        <div class="bg-white rounded-lg shadow-md overflow-hidden transition-transform duration-300 hover:-translate-y-1 flex flex-col">
          <div class="p-6 flex-grow">
            <div class="flex items-center mb-4">
              <img src={item?.logo} alt={`${item?.name} logo`} class="w-10 h-10 object-contain mr-3" />
              <h3 class="text-xl font-normal text-blue-900">{item?.name}</h3>
            </div>
            <p class="text-sm text-blue-900 mb-4">{item?.description}</p>
          </div>
          <div class="px-6 pb-6">
            <a href={item?.link} class="block w-full bg-counterparty-red hover:bg-red-600 text-white text-center font-bold py-2 px-4 rounded transition duration-300" target="_blank" rel="noopener noreferrer">
              Visit {item?.name}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #collections::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url('/images/pattern.png');
    background-repeat: repeat;
    mask-image: linear-gradient(to bottom, transparent, black);
    -webkit-mask-image: linear-gradient(to bottom, transparent, black);
    z-index: 0;
  }
</style>
