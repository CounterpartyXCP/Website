---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found | Counterparty">
  <main class="bg-white py-24 relative min-h-[60vh] flex items-center">
    <div class="max-w-screen-xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl font-light text-blue-900 mb-4">404</h1>
      <p class="text-xl text-gray-600 mb-8">The page you are looking for could not be found.</p>
      <a href="/" class="bg-counterparty-red hover:bg-red-600 text-white font-bold py-2 px-6 rounded transition duration-300">
        Return Home
      </a>
    </div>
  </main>
</Layout>
